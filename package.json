{
  "name": "securesphere-x",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node tools/hooks/install.mjs",
    "typecheck": "tsc -b",
    "test:fixtures": "node --experimental-strip-types tools/ci/test-fixtures.ts",
    "test:properties": "node --experimental-strip-types packages/engine/b1-5.properties.test.ts",
    "check:conformance-config": "node tools/ci/check-conformance-config.mjs",
    "test:psl": "node --experimental-strip-types apps/harness/extract/psl-conformance.fixture.test.ts",
    "test:determinism": "node --experimental-strip-types apps/harness/extract/s6-determinism.test.ts",
    "test:readboundary": "node --experimental-strip-types apps/harness/extract/read-boundary.test.ts",
    "test:tier1e2e": "node --experimental-strip-types apps/harness/extract/tier1-e2e.test.ts",
    "test:extension": "node --experimental-strip-types apps/extension/session-survival.test.ts",
    "test:conformance": "node --experimental-strip-types tools/conformance/login-interface.conformance.test.ts",
    "test:cred-livepath": "node --experimental-strip-types tools/conformance/cred-live-path.test.ts",
    "test:cred02livepath": "node --experimental-strip-types tools/conformance/cred02-live-path.test.ts",
    "test:redirect": "node --experimental-strip-types tools/conformance/redirect-producer.test.ts",
    "test:authstore": "node --experimental-strip-types apps/extension/auth-store.test.ts",
    "test:moduleeval": "node --experimental-strip-types apps/extension/module-eval.test.ts",
    "test:authcontext": "node --experimental-strip-types apps/extension/auth-context.test.ts",
    "test:loginsuccess": "node --experimental-strip-types apps/extension/login-success.test.ts",
    "test:multipass": "node --experimental-strip-types apps/extension/multi-pass-session.test.ts",
    "test:downloadrepass": "node --experimental-strip-types apps/extension/download-repass.test.ts",
    "test:intervention": "node --experimental-strip-types apps/extension/intervention.test.ts",
    "metrics:confusion": "node --experimental-strip-types apps/harness/metrics/confusion.ts",
    "validate:ruleset": "node tools/ci/run-python.mjs tools/ci/validate-ruleset.py",
    "digest:ruleset": "node tools/ci/compute-ruleset-digest.mjs",
    "build:extension": "node apps/extension/build-extension.mjs",
    "verify:all": "npm run typecheck && npx eslint . --max-warnings=0 && node tools/ci/architectural-gates.mjs && npx depcruise --config .dependency-cruiser.cjs packages apps tools && npm run test:fixtures && npm run validate:ruleset && npm run test:v16 && npm run check:conformance-config && npm run test:psl && node tools/ci/run-python.mjs tools/ci/contract-conformance-check.py && npm run test:properties && npm run test:extension && npm run test:conformance && npm run test:cred-livepath && npm run test:cred02livepath && npm run test:cred04livepath && npm run test:dllivepath && npm run test:pm01unit && npm run test:redirect && npm run test:authstore && npm run test:moduleeval && npm run test:authcontext && npm run test:loginsuccess && npm run test:multipass && npm run test:downloadrepass && npm run test:intervention && npm run test:tier1e2e",
    "test:cred04livepath": "node --experimental-strip-types tools/conformance/cred04-live-path.test.ts",
    "test:dllivepath": "node --experimental-strip-types tools/conformance/dl-live-path.test.ts",
    "test:pm01unit": "node --experimental-strip-types tools/conformance/pm01-predicate-unit.test.ts",
    "test:v16": "node --experimental-strip-types tools/conformance/v16-nullable-negation.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/jsdom": "^30.0.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "tldts": "^7.4.11"
  }
}
