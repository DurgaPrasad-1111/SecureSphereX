        "evidence": {
          "$ref": "#/$defs/EvidenceByCategory"
        }
      },
      "required": [
        "targetResourceId",
        "analysisSessionId",
        "evidenceId",
        "collectionContext",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "Complete Security Evidence for one analysis pass.\n\nImmutable on creation (Domain Model §5.2). Every category is always present as an object; individual fields carry their own tri-state. A module never receives a missing category — it receives a category whose fields are `notCollected`."
    },
