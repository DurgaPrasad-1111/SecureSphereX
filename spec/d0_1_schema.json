        "passOrdinal": {
          "type": "number"
        },
        "collectedOn": {
          "type": "string",
          "description": "Day granularity only. Rule Engine §20.3 — no precise timestamps."
        },
        "evidenceContractVersion": {
          "type": "string",
          "const": "1.1.0"
        }
      },
      "required": [
        "collector",
        "collectorVersion",
